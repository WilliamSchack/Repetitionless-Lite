#pragma kernel CSMain

RWTexture2D<float4> HolesTexture;
Texture2D<float4> BrushTexture;

SamplerState sampler_LinearClamp;

int BrushChannel;

float4 HitUV;
float Radius;
float RotationRadians;
float Cutoff;

bool EraseHoles;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    HolesTexture.GetDimensions(width, height);

    float2 uv = id.xy / float2(width, height);

    // Get the distance from the current uv to the hit uv
    // If its within the radius add the target colour
    
    float dist = distance(uv, HitUV.xy);
    if (dist >= Radius)
        return;

    float brushValue = 1.0;
    if (BrushChannel >= 0) {
        // Sample texture
        float2 brushUV = (uv - HitUV.xy) / (Radius * 2) + 0.5;

        // Rotate texture if required
        if (RotationRadians != 0) {
            float s = sin(RotationRadians);
            float c = cos(RotationRadians);
            float2 centered = brushUV - 0.5;
            float2 rotated = float2(
                centered.x * c - centered.y * s,
                centered.x * s + centered.y * c
            );
            brushUV = rotated + 0.5;
        }

        brushValue = BrushTexture.SampleLevel(sampler_LinearClamp, brushUV, 0)[BrushChannel];
    }

    if (brushValue <= Cutoff)
        return;
    
    float value = EraseHoles ? 1.0 : 0.0;
    HolesTexture[id.xy] = float4(value, value, value, 1.0);
}